Description: Microsoft Defender MpEngineDb (MetaVault) - decrypted copy of mpenginedb.db
Author: Mato Vlajcic
Email: vlajcic.mato@gmail.com
Id: 2e4c7b1a-6d3f-4a8e-9c52-8f1d0b7e3a61
Version: 1.0
CSVPrefix: MicrosoftDefender
FileName: mpenginedb_decrypted.db
IdentifyQuery: SELECT count(*) FROM sqlite_master WHERE type='table' AND (name='RollingQueuesValues' OR name='RollingQueuesTables' OR name='AttributePersistContext' OR name='BackupProcessInfo' OR name='FileHashes' OR name='SQLiteGlobals');
IdentifyValue: 6
Queries:
    -
        Name: Defender MpEngineDb rolling queues (per-process attack scoring and named queues)
        Query: |
                SELECT
                v.ID,
                CASE WHEN v.InsertTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(v.InsertTime / 10000000 - 11644473600, 'unixepoch'), v.InsertTime % 10000000) END AS InsertTimeUTC,
                CASE WHEN v.ExpireTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(v.ExpireTime / 10000000 - 11644473600, 'unixepoch'), v.ExpireTime % 10000000) END AS ExpireTimeUTC,
                v.EntryTable AS Queue,
                CASE
                WHEN v.EntryTable LIKE 'Tech-pid:%' THEN 'Techniques of process (attack scoring)'
                WHEN v.EntryTable LIKE 'Tact-pid:%' THEN 'Tactics/rules of process (attack scoring)'
                WHEN v.EntryTable LIKE 'InheritedTech-pid:%' THEN 'Inherited techniques (attack scoring)'
                WHEN v.EntryTable LIKE 'InheritedTact-pid:%' THEN 'Inherited tactics (attack scoring)'
                WHEN v.EntryTable = 'gPidsTable' THEN 'Processes tracked by attack scoring'
                WHEN v.EntryTable = 'gTechniquesTable' THEN 'Techniques seen on machine'
                WHEN v.EntryTable = 'gTacticsTable' THEN 'Tactics/rules seen on machine'
                WHEN v.EntryTable = 'RecentThreatsOnMachine' THEN 'Behaviour detections on machine'
                WHEN v.EntryTable LIKE 'RQ_RecentExecDropped%' THEN 'Dropped executable flagged'
                ELSE 'Named queue (signature defined)' END AS QueueType,
                CASE WHEN CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END IS NOT NULL THEN CAST(substr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, instr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, 'pid:') + 4, instr(substr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, instr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, 'pid:')), ',') - 5) AS INTEGER) END AS PID,
                CASE WHEN CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END IS NOT NULL THEN printf('%s.%07d', datetime(CAST(substr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, instr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, 'ProcessStart:') + 13, 18) AS INTEGER) / 10000000 - 11644473600, 'unixepoch'), CAST(substr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, instr(CASE WHEN instr(v.EntryTable,'pid:') > 0 THEN v.EntryTable WHEN instr(v.EntryKey,'pid:') > 0 THEN v.EntryKey WHEN instr(v.EntryValue,'pid:') > 0 THEN v.EntryValue END, 'ProcessStart:') + 13, 18) AS INTEGER) % 10000000) END AS ProcessStartUTC,
                v.EntryKey,
                v.EntryValue,
                t.Capacity AS QueueCapacity,
                t.TimeToLive AS QueueTTLSeconds,
                v.InsertTime AS InsertTimeRaw,
                v.ExpireTime AS ExpireTimeRaw
                FROM RollingQueuesValues v
                LEFT JOIN RollingQueuesTables t ON v.EntryTable = ifnull(t.Namespace, '') || t.Name
                ORDER BY v.InsertTime ASC;
        BaseFileName: RollingQueues
    -
        Name: Defender MpEngineDb persisted context tags and ASR rule state
        Query: |
                SELECT
                ID,
                CASE WHEN InsertTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InsertTime / 10000000 - 11644473600, 'unixepoch'), InsertTime % 10000000) END AS InsertTimeUTC,
                CASE WHEN ExpireTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ExpireTime / 10000000 - 11644473600, 'unixepoch'), ExpireTime % 10000000) END AS ExpireTimeUTC,
                FilePath,
                Context,
                CASE WHEN FilePath LIKE 'AsrRuleStateChangeFor:%' THEN 'ASR rule state (engine)' ELSE 'Path tag (signature)' END AS RecordKind,
                CASE WHEN CASE WHEN FilePath LIKE 'AsrRuleStateChangeFor:%' THEN substr(FilePath, 23) END IS NULL OR CASE WHEN FilePath LIKE 'AsrRuleStateChangeFor:%' THEN substr(FilePath, 23) END = '' THEN NULL ELSE CASE lower(CASE WHEN FilePath LIKE 'AsrRuleStateChangeFor:%' THEN substr(FilePath, 23) END) WHEN '01443614-cd74-433a-b99e-2ecdc07bfc25' THEN 'Block executable files from running unless they meet a prevalence, age, or trusted list criterion' WHEN '26190899-1602-49e8-8b27-eb1d0a1ce869' THEN 'Block Office communication application from creating child processes' WHEN '33ddedf1-c6e0-47cb-833e-de6133960387' THEN 'Block rebooting machine in Safe Mode' WHEN '3b576869-a4ec-4529-8536-b80a7769e899' THEN 'Block Office applications from creating executable content' WHEN '56a863a9-875e-4185-98a7-b882c64b5ce5' THEN 'Block abuse of exploited vulnerable signed drivers (Device)' WHEN '5beb7efe-fd9a-4556-801d-275e5ffc04cc' THEN 'Block execution of potentially obfuscated scripts' WHEN '75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84' THEN 'Block Office applications from injecting code into other processes' WHEN '7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c' THEN 'Block Adobe Reader from creating child processes' WHEN '92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b' THEN 'Block Win32 API calls from Office macros' WHEN '9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2' THEN 'Block credential stealing from the Windows local security authority subsystem' WHEN 'a8f5898e-1dc8-49a9-9878-85004b8a61e6' THEN 'Block Webshell creation for Servers' WHEN 'b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4' THEN 'Block untrusted and unsigned processes that run from USB' WHEN 'be9ba2d9-53ea-4cdc-84e5-9b1eeee46550' THEN 'Block executable content from email client and webmail' WHEN 'c0033c00-d16d-4114-a5a0-dc9b3a7d2ceb' THEN 'Block use of copied or impersonated system tools' WHEN 'c1db55ab-c21a-4637-bb3f-a12568109d35' THEN 'Use advanced protection against ransomware' WHEN 'd1e49aac-8f56-4280-b9ba-993a6d77406c' THEN 'Block process creations originating from PSExec and WMI commands' WHEN 'd3e037e1-3eb8-44c8-a917-57927947596d' THEN 'Block JavaScript or VBScript from launching downloaded executable content' WHEN 'd4f940ab-401b-4efc-aadc-ad5f3c50688a' THEN 'Block all Office applications from creating child processes' WHEN 'e6db77e5-3df2-4cf1-b95a-636979351e5b' THEN 'Block persistence through WMI event subscription' ELSE 'Not in Microsoft published ASR list' END END AS ASRRule,
                InsertTime AS InsertTimeRaw,
                ExpireTime AS ExpireTimeRaw
                FROM AttributePersistContext
                ORDER BY InsertTime ASC;
        BaseFileName: PersistContext
    -
        Name: Defender MpEngineDb real-time protection file hash cache
        Query: |
                SELECT
                ID,
                CASE WHEN InstanceTimeStamp BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InstanceTimeStamp / 10000000 - 11644473600, 'unixepoch'), InstanceTimeStamp % 10000000) END AS InstanceTimeStampUTC,
                printf('%04X-%04X', (VSN >> 16) & 65535, VSN & 65535) AS VolumeSerial,
                FileID & 281474976710655 AS MFTEntry,
                (FileID >> 48) & 65535 AS MFTSequence,
                USN,
                hex(SHA1) AS MD5,
                hex(MD5) AS SHA1,
                hex(SHA256) AS SHA256,
                CAST(CASE WHEN instr(CTPH, X'00') > 0 THEN substr(CTPH, 1, instr(CTPH, X'00') - 1) ELSE CTPH END AS TEXT) AS SSDeep,
                hex(LSHASH) AS LSHASH,
                hex(LSHASHS) AS LSHASHS,
                printf('%08X', PartialCRC1 & 4294967295) AS PartialCRC1,
                printf('%08X', PartialCRC2 & 4294967295) AS PartialCRC2,
                printf('%08X', PartialCRC3 & 4294967295) AS PartialCRC3,
                printf('%08X', KCRC1 & 4294967295) AS KCRC1,
                printf('%08X', KCRC2 & 4294967295) AS KCRC2,
                printf('%08X', KCRC3 & 4294967295) AS KCRC3,
                printf('%08X', KCRC3n & 4294967295) AS KCRC3n,
                FileID AS FileIDRaw
                FROM FileHashes
                ORDER BY InstanceTimeStamp ASC;
        BaseFileName: FileHashes
    -
        Name: Defender MpEngineDb files and processes tracked for ransomware rollback
        Query: |
                SELECT
                ID,
                CASE WHEN InstanceTimeStamp BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InstanceTimeStamp / 10000000 - 11644473600, 'unixepoch'), InstanceTimeStamp % 10000000) END AS InstanceTimeStampUTC,
                FilePath,
                CASE WHEN FirstStartTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(FirstStartTime / 10000000 - 11644473600, 'unixepoch'), FirstStartTime % 10000000) END AS FirstStartTimeUTC,
                CASE WHEN FirstStartTime BETWEEN 119600064000000000 AND 159793632000000000 THEN 'Process start time' ELSE 'Identifier, not a time' END AS FirstStartTimeMeaning,
                FirstStartTime AS FirstStartTimeRaw,
                NextUSN,
                AutomaticRemovalPolicy,
                ImpactedCBPNameSpaces
                FROM BackupProcessInfo
                ORDER BY InstanceTimeStamp ASC;
        BaseFileName: BackupProcessInfo
    -
        Name: Defender MpEngineDb LowFi signature hits sent for async cloud lookup
        Query: |
                SELECT
                ID,
                CASE WHEN InstanceTimeStamp BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InstanceTimeStamp / 10000000 - 11644473600, 'unixepoch'), InstanceTimeStamp % 10000000) END AS InstanceTimeStampUTC,
                FileName,
                SigSeq,
                hex(SigSha) AS SigSha,
                SigIsSync
                FROM FileLowFiAsync
                ORDER BY InstanceTimeStamp ASC;
        BaseFileName: LowFiAsync
    -
        Name: Defender MpEngineDb schema version history (creation and upgrades)
        Query: |
                SELECT
                ID,
                Version AS SchemaVersion,
                Current,
                LastUpdated AS LastUpdatedUTC,
                CASE WHEN (SELECT count(*) FROM SQLiteGlobals) = 1 THEN 'Single row: created by an engine already at this version (normal on a recent install, otherwise recreated)'
                ELSE 'Upgraded in place' END AS Note
                FROM SQLiteGlobals
                ORDER BY Version ASC;
        BaseFileName: SchemaHistory
    -
        Name: Defender MpEngineDb AMSI scan result cache
        Query: |
                SELECT
                ID,
                ExpirationDate AS ExpirationDateUTC,
                PersistId,
                hex(PersistIdBlob) AS PersistIdBlob
                FROM AmsiFileCache
                ORDER BY ExpirationDate ASC;
        BaseFileName: AmsiFileCache
    -
        Name: Defender MpEngineDb blocked processes (90 day retention)
        Query: |
                SELECT
                ID,
                CASE WHEN TimeStamp BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(TimeStamp / 10000000 - 11644473600, 'unixepoch'), TimeStamp % 10000000) END AS TimeStampUTC,
                ProcessPath,
                TargetPath,
                CASE WHEN length(RuleId) = 16 THEN lower(substr(hex(RuleId),7,2)||substr(hex(RuleId),5,2)||substr(hex(RuleId),3,2)||substr(hex(RuleId),1,2)||'-'||substr(hex(RuleId),11,2)||substr(hex(RuleId),9,2)||'-'||substr(hex(RuleId),15,2)||substr(hex(RuleId),13,2)||'-'||substr(hex(RuleId),17,4)||'-'||substr(hex(RuleId),21,12)) END AS RuleId,
                CASE WHEN CASE WHEN length(RuleId) = 16 THEN lower(substr(hex(RuleId),7,2)||substr(hex(RuleId),5,2)||substr(hex(RuleId),3,2)||substr(hex(RuleId),1,2)||'-'||substr(hex(RuleId),11,2)||substr(hex(RuleId),9,2)||'-'||substr(hex(RuleId),15,2)||substr(hex(RuleId),13,2)||'-'||substr(hex(RuleId),17,4)||'-'||substr(hex(RuleId),21,12)) END IS NULL OR CASE WHEN length(RuleId) = 16 THEN lower(substr(hex(RuleId),7,2)||substr(hex(RuleId),5,2)||substr(hex(RuleId),3,2)||substr(hex(RuleId),1,2)||'-'||substr(hex(RuleId),11,2)||substr(hex(RuleId),9,2)||'-'||substr(hex(RuleId),15,2)||substr(hex(RuleId),13,2)||'-'||substr(hex(RuleId),17,4)||'-'||substr(hex(RuleId),21,12)) END = '' THEN NULL ELSE CASE lower(CASE WHEN length(RuleId) = 16 THEN lower(substr(hex(RuleId),7,2)||substr(hex(RuleId),5,2)||substr(hex(RuleId),3,2)||substr(hex(RuleId),1,2)||'-'||substr(hex(RuleId),11,2)||substr(hex(RuleId),9,2)||'-'||substr(hex(RuleId),15,2)||substr(hex(RuleId),13,2)||'-'||substr(hex(RuleId),17,4)||'-'||substr(hex(RuleId),21,12)) END) WHEN '01443614-cd74-433a-b99e-2ecdc07bfc25' THEN 'Block executable files from running unless they meet a prevalence, age, or trusted list criterion' WHEN '26190899-1602-49e8-8b27-eb1d0a1ce869' THEN 'Block Office communication application from creating child processes' WHEN '33ddedf1-c6e0-47cb-833e-de6133960387' THEN 'Block rebooting machine in Safe Mode' WHEN '3b576869-a4ec-4529-8536-b80a7769e899' THEN 'Block Office applications from creating executable content' WHEN '56a863a9-875e-4185-98a7-b882c64b5ce5' THEN 'Block abuse of exploited vulnerable signed drivers (Device)' WHEN '5beb7efe-fd9a-4556-801d-275e5ffc04cc' THEN 'Block execution of potentially obfuscated scripts' WHEN '75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84' THEN 'Block Office applications from injecting code into other processes' WHEN '7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c' THEN 'Block Adobe Reader from creating child processes' WHEN '92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b' THEN 'Block Win32 API calls from Office macros' WHEN '9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2' THEN 'Block credential stealing from the Windows local security authority subsystem' WHEN 'a8f5898e-1dc8-49a9-9878-85004b8a61e6' THEN 'Block Webshell creation for Servers' WHEN 'b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4' THEN 'Block untrusted and unsigned processes that run from USB' WHEN 'be9ba2d9-53ea-4cdc-84e5-9b1eeee46550' THEN 'Block executable content from email client and webmail' WHEN 'c0033c00-d16d-4114-a5a0-dc9b3a7d2ceb' THEN 'Block use of copied or impersonated system tools' WHEN 'c1db55ab-c21a-4637-bb3f-a12568109d35' THEN 'Use advanced protection against ransomware' WHEN 'd1e49aac-8f56-4280-b9ba-993a6d77406c' THEN 'Block process creations originating from PSExec and WMI commands' WHEN 'd3e037e1-3eb8-44c8-a917-57927947596d' THEN 'Block JavaScript or VBScript from launching downloaded executable content' WHEN 'd4f940ab-401b-4efc-aadc-ad5f3c50688a' THEN 'Block all Office applications from creating child processes' WHEN 'e6db77e5-3df2-4cf1-b95a-636979351e5b' THEN 'Block persistence through WMI event subscription' ELSE 'Not in Microsoft published ASR list' END END AS ASRRule,
                IsAudit,
                Action,
                ProcessTaintReason,
                ProcessIntegrity
                FROM ProcessBlockHistory
                ORDER BY TimeStamp ASC;
        BaseFileName: ProcessBlockHistory
    -
        Name: Defender MpEngineDb behaviour monitored processes
        Query: |
                SELECT
                ID,
                CASE WHEN ProcessStartTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ProcessStartTime / 10000000 - 11644473600, 'unixepoch'), ProcessStartTime % 10000000) END AS ProcessStartTimeUTC,
                PID,
                ImageFileName,
                CommandLineArgs,
                PPIDHash,
                Flags,
                MonitoringFlags_Flags,
                CASE WHEN length(HipsInjectionId) = 16 THEN lower(substr(hex(HipsInjectionId),7,2)||substr(hex(HipsInjectionId),5,2)||substr(hex(HipsInjectionId),3,2)||substr(hex(HipsInjectionId),1,2)||'-'||substr(hex(HipsInjectionId),11,2)||substr(hex(HipsInjectionId),9,2)||'-'||substr(hex(HipsInjectionId),15,2)||substr(hex(HipsInjectionId),13,2)||'-'||substr(hex(HipsInjectionId),17,4)||'-'||substr(hex(HipsInjectionId),21,12)) END AS HipsInjectionId,
                CASE WHEN length(FolderGuardId) = 16 THEN lower(substr(hex(FolderGuardId),7,2)||substr(hex(FolderGuardId),5,2)||substr(hex(FolderGuardId),3,2)||substr(hex(FolderGuardId),1,2)||'-'||substr(hex(FolderGuardId),11,2)||substr(hex(FolderGuardId),9,2)||'-'||substr(hex(FolderGuardId),15,2)||substr(hex(FolderGuardId),13,2)||'-'||substr(hex(FolderGuardId),17,4)||'-'||substr(hex(FolderGuardId),21,12)) END AS FolderGuardId,
                CASE WHEN length(LsassReadMemId) = 16 THEN lower(substr(hex(LsassReadMemId),7,2)||substr(hex(LsassReadMemId),5,2)||substr(hex(LsassReadMemId),3,2)||substr(hex(LsassReadMemId),1,2)||'-'||substr(hex(LsassReadMemId),11,2)||substr(hex(LsassReadMemId),9,2)||'-'||substr(hex(LsassReadMemId),15,2)||substr(hex(LsassReadMemId),13,2)||'-'||substr(hex(LsassReadMemId),17,4)||'-'||substr(hex(LsassReadMemId),21,12)) END AS LsassReadMemId
                FROM BmProcessInfo
                ORDER BY ProcessStartTime ASC;
        BaseFileName: BmProcessInfo
    -
        Name: Defender MpEngineDb ransomware detections and remediation
        Query: |
                SELECT
                ID,
                DetectionGuid,
                CASE WHEN DetectionTS BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(DetectionTS / 10000000 - 11644473600, 'unixepoch'), DetectionTS % 10000000) END AS DetectionUTC,
                CASE WHEN LkgTS BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(LkgTS / 10000000 - 11644473600, 'unixepoch'), LkgTS % 10000000) END AS LastKnownGoodUTC,
                CASE WHEN ProvisionalRemedComplTS BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ProvisionalRemedComplTS / 10000000 - 11644473600, 'unixepoch'), ProvisionalRemedComplTS % 10000000) END AS ProvisionalRemediationUTC,
                CASE WHEN RemedComplTS BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(RemedComplTS / 10000000 - 11644473600, 'unixepoch'), RemedComplTS % 10000000) END AS RemediationCompleteUTC,
                CASE WHEN InstanceTimeStamp BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InstanceTimeStamp / 10000000 - 11644473600, 'unixepoch'), InstanceTimeStamp % 10000000) END AS InstanceTimeStampUTC,
                NextUSN,
                ImpactedCBPNameSpaces
                FROM RansomwareDetections
                ORDER BY DetectionTS ASC;
        BaseFileName: RansomwareDetections
    -
        Name: Defender MpEngineDb firewall rules created by network protection
        Query: |
                SELECT
                'Incoming' AS Direction, ID, CASE WHEN ExpiryTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ExpiryTime / 10000000 - 11644473600, 'unixepoch'), ExpiryTime % 10000000) END AS ExpiryUTC, Key, FirewallRuleName FROM NetworkIpFirewallRules
                UNION ALL
                SELECT
                'Outgoing' AS Direction, ID, CASE WHEN ExpiryTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ExpiryTime / 10000000 - 11644473600, 'unixepoch'), ExpiryTime % 10000000) END AS ExpiryUTC, Key, FirewallRuleName FROM NetworkIpFirewallRulesOutgoing
                ORDER BY ExpiryUTC ASC;
        BaseFileName: FirewallRules
    -
        Name: Defender MpEngineDb atomic counters set by signatures
        Query: |
                SELECT
                ID,
                CASE WHEN InsertTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(InsertTime / 10000000 - 11644473600, 'unixepoch'), InsertTime % 10000000) END AS InsertTimeUTC,
                CASE WHEN UpdateTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(UpdateTime / 10000000 - 11644473600, 'unixepoch'), UpdateTime % 10000000) END AS UpdateTimeUTC,
                CASE WHEN ExpireTime BETWEEN 119600064000000000 AND 159793632000000000 THEN printf('%s.%07d', datetime(ExpireTime / 10000000 - 11644473600, 'unixepoch'), ExpireTime % 10000000) END AS ExpireTimeUTC,
                Namespace,
                Name,
                Count,
                HighCount
                FROM AtomicCounters
                ORDER BY InsertTime ASC;
        BaseFileName: AtomicCounters
    -
        Name: Defender MpEngineDb Controlled Folder Access paths
        Query: |
                SELECT
                ID,
                UserId,
                CASE WHEN length(GUID) = 16 THEN lower(substr(hex(GUID),7,2)||substr(hex(GUID),5,2)||substr(hex(GUID),3,2)||substr(hex(GUID),1,2)||'-'||substr(hex(GUID),11,2)||substr(hex(GUID),9,2)||'-'||substr(hex(GUID),15,2)||substr(hex(GUID),13,2)||'-'||substr(hex(GUID),17,4)||'-'||substr(hex(GUID),21,12)) END AS GUID,
                Path
                FROM FolderGuardPaths;
        BaseFileName: FolderGuardPaths

# Documentation
# The original C:\ProgramData\Microsoft\Windows Defender\Scans\mpenginedb.db is RC4 encrypted (fixed key from mpengine.dll,
# restarted per page). SQLECmd skips it because the SQLite header is encrypted. Decrypt it first with Decrypt-MpEngineDb.ps1
# or mpenginedb_parser.py, which write mpenginedb_decrypted.db with the -wal already applied, then run SQLECmd on that folder.
# All times are UTC, decoded from Windows FILETIME with 100 ns precision. Raw values are kept in *Raw columns.
# FileHashes: Defender stores MD5 in the column named SHA1 and SHA-1 in the column named MD5. This map outputs them correctly.
# Tech-/Tact- queues hold Defender per-process attack scoring (MITRE ATT&CK technique IDs and rule names, 1 hour lifetime).
# ASR rule names: https://learn.microsoft.com/defender-endpoint/attack-surface-reduction-rules-reference
# Deleted rows, WAL history and value labels: use mpenginedb_parser.py.
